# Copy this file to .env.local and fill in your values.
# Then run `node build.js` to generate dist/config.js.

# Appwrite endpoint — Cloud regions:
#   default:   https://cloud.appwrite.io/v1
#   Singapore: https://sgp.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite project ID  (Settings → General → Project ID)
APPWRITE_PROJECT_ID=6a153e01002b09c4cc7b

# Your Appwrite database ID  (Databases → your DB → Database ID)
APPWRITE_DATABASE_ID=6a15411c002574e3b93e
