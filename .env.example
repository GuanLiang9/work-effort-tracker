# Copy this file to .env.local and fill in your values.
# Get these from: Appwrite Console → your project → Settings

# Appwrite Cloud endpoint (leave as-is for cloud.appwrite.io)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID (Settings → General → Project ID)
APPWRITE_PROJECT_ID=your-project-id

# Your Appwrite Database ID (Databases → your database → Database ID)
APPWRITE_DATABASE_ID=your-database-id
